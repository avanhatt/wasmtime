;; Minimum non-zero ys (=1) for i32: ishl by 31, ushr by 1.
function %a64_extr_i32_1(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = ushr_imm v0, 1
    v3 = ishl_imm v1, 31
    v4 = bor v2, v3
    return v4
}

