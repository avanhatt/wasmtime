;   extr w0, w1, w0, #1
;   ret

function %a64_extr_i32_1_swap(i32, i32) -> i32 {
block0(v0: i32, v1: i32):
    v2 = ishl_imm v0, 31
    v3 = ushr_imm v1, 1
    v4 = bor v2, v3
    return v4
}

