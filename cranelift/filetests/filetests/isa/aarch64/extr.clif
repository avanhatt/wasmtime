;; Same-register rotation pattern for i32 (becomes a self-extr / rotation).
function %a64_extr_i32_same_8(i32) -> i32 {
block0(v0: i32):
    v1 = ushr_imm v0, 8
    v2 = ishl_imm v0, 24
    v3 = bor v1, v2
    return v3
}

; VCode:
; block0:
;   extr w0, w0, w0, LSL 8
;   ret
;
; Disassembled:
; block0: ; offset 0x0
;   ror w0, w0, #8
;   ret

function %a64_extr_i32_same_8_swap(i32) -> i32 {
block0(v0: i32):
    v1 = ishl_imm v0, 24
    v2 = ushr_imm v0, 8
    v3 = bor v1, v2
    return v3
}

